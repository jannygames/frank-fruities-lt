{% comment %}
  Subscription Handler Snippet
  Provides subscription data and logic for products

  Usage:
  {% render 'subscription-handler', product: product, variant: variant %}
{% endcomment %}

{% assign has_subscription = false %}
{% assign monthly_plan = null %}
{% assign monthly_plan_id = null %}

{% if product.selling_plan_groups.size > 0 %}
  {% for group in product.selling_plan_groups %}
    {% for plan in group.selling_plans %}
      {% comment %}Look for monthly plan (1 month delivery){% endcomment %}
      {% if plan.options.first.value contains '1' %}
        {% assign has_subscription = true %}
        {% assign monthly_plan = plan %}
        {% assign monthly_plan_id = plan.id %}
        {% break %}
      {% endif %}
    {% endfor %}
    {% if has_subscription %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

<script>
  window.frankFruitiesSubscription = window.frankFruitiesSubscription || {};
  window.frankFruitiesSubscription.hasSubscription = {{ has_subscription | json }};
  window.frankFruitiesSubscription.monthlyPlanId = {{ monthly_plan_id | json }};
  window.frankFruitiesSubscription.discountPercentage = 15;
</script>
