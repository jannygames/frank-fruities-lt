<div class="py-20 px-4 lg:px-0 mt-20">
  <div class="lg:w-[80%] m-auto pt-12 lg:pt-24">
    <div class="mb-3 lg:mb-7">
      <h2 class="colored-title text-black font-bold text-3xl lg:text-4xl leading-snug uppercase">
        Peržiūrėti <strong>krepšelį</strong>
      </h2>
    </div>

    <div class="lg:w-[80%]">
      {% if cart.item_count > 0 %}
        <form id="cart" action="{{ routes.cart_url }}" method="post">
          <div class="mb-10">
            {% for item in cart.items %}
              <div class="py-5 {% unless forloop.last %}border-b{% endunless %} border-[#D3D3D3] flex flex-col md:flex-row gap-5">
                <div class="rounded-md overflow-hidden">
                  {{ item.product.featured_image | image_url: width: 100 | image_tag: alt: item.product.title }}
                </div>

                <div class="flex flex-col justify-center md:w-[30%]">
                  <div class="font-medium text-[#343057]">
                    {{ item.title }}
                  </div>

                  <!-- Subscription Badge -->
                  {% if item.selling_plan_allocation %}
                    <div class="mt-1 bg-gradient-to-r from-[#f8f9fa] to-[#e9ecef] rounded-md p-2">
                      <div class="flex items-center justify-between mb-1">
                        <div class="text-xs font-semibold text-[#343057]">✓ Mėnesinė prenumerata</div>
                        <div class="text-xs bg-[#FF5E5E] text-white px-2 py-0.5 rounded-full">-15%</div>
                      </div>
                      <div class="text-left">
                        <div class="text-xs text-[#6F6F6F] mb-1">Prekės atvyksta kas mėnesį</div>
                        <button
                          onclick="switchToOneTime('{{ item.key }}', {{ item.quantity }})"
                          class="text-xs text-[#FF5E5E] underline hover:no-underline text-left"
                        >
                          Keisti į vienkartinį →
                        </button>
                      </div>
                    </div>
                  {% elsif item.product.selling_plan_groups.size > 0 %}
                    <div class="mt-1 bg-gradient-to-r from-[#f8f9fa] to-[#e9ecef] rounded-md p-2">
                      <div class="text-xs font-semibold text-[#343057] mb-1">Prenumeruokite ir sutaupykite 15%</div>
                      {% assign monthly_plan_id = null %}
                      {% for group in item.product.selling_plan_groups %}
                        {% for plan in group.selling_plans %}
                          {% assign monthly_plan_id = plan.id %}
                          {% break %}
                        {% endfor %}
                        {% if monthly_plan_id %}
                          {% break %}
                        {% endif %}
                      {% endfor %}
                      <button
                        onclick="switchToSubscription('{{ item.key }}', '{{ monthly_plan_id }}')"
                        class="text-xs text-[#FF5E5E] underline hover:no-underline"
                      >
                        Keisti į mėnesinę prenumeratą →
                      </button>
                    </div>
                  {% endif %}

                  <div class="font-semibold text-lg mt-1">
                    {% if item.selling_plan_allocation %}
                      <div class="flex items-center gap-2">
                        <span class="text-[#FF5E5E]">{{ item.final_price | money }}</span>
                        <span class="line-through text-[#C7C7C7] text-sm">{{ item.original_price | money }}</span>
                      </div>
                    {% else %}
                      {{ item.final_price | money }}
                    {% endif %}
                  </div>
                </div>

                <div class="flex flex-col justify-center w-[150px]">
                  <input
                    id="quantity-{{ forloop.index }}"
                    type="hidden"
                    name="updates[]"
                    min="1"
                    value="{{ item.quantity }}"
                  >

                  <div class="flex flex-row py-[0.3rem] px-3 border border-[#D9D9D9] rounded-[10px]">
                    <div class="flex items-center">
                      <a class="product-quantity-less" href="#" data-index="{{ forloop.index }}">
                        <img src="{{ 'product-size-minus.svg' | asset_url }}" width="auto" height="auto" alt="Less">
                      </a>
                    </div>

                    <div
                      id="product-quantity-text-{{ forloop.index }}"
                      class="w-16 font-semibold text-[1.25rem] text-center"
                    >
                      {{ item.quantity }}
                    </div>

                    <div class="flex items-center">
                      <a class="product-quantity-more" href="#" data-index="{{ forloop.index }}">
                        <img src="{{ 'product-size-plus.svg' | asset_url }}" width="auto" height="auto" alt="More">
                      </a>
                    </div>
                  </div>
                </div>

                <div class="flex flex-col justify-center">
                  <div class="md:px-10">
                    <a class="text-sm text-[#FF5E5E]" href="{{ item.url_to_remove }}">Šalinti</a>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>

          <div class="mb-10">
            <div class="mb-3">
              Subtotal: <span class="font-semibold text-lg">{{ cart.items_subtotal_price | money }}</span>
            </div>

            <div class="italic font-light">Mokesčiai įskaičiuoti. Pristatymas paskaičiuojamas atsiskaitymo metu.</div>
          </div>

          <div class="mb-10 flex flex-col md:flex-row gap-4">
            <input
              type="submit"
              name="checkout"
              value="Checkout"
              class="bg-[#343057] text-center rounded-lg text-[#fff] text-md py-3 px-16 w-full md:w-auto cursor-pointer"
            >
            <a
              href="{{ routes.all_products_collection_url }}"
              class="text-center border border-[#343057] rounded-lg text-[#343057] text-md py-3 px-16 w-full md:w-auto hover:bg-[#343057] hover:text-white transition-colors duration-200"
            >
              Tęsti apsipirkimą
            </a>
          </div>
        </form>
      {% else %}
        <div class="pb-60">
          Jūsų krepšelis tuščias.

          <div class="flex flex-col md:flex-row gap-4 mt-20">
            <a
              href="{{ routes.all_products_collection_url }}"
              class="text-center border border-[#343057] rounded-lg text-[#343057] text-md py-3 px-16 w-full md:w-auto hover:bg-[#343057] hover:text-white transition-colors duration-200"
            >
              Tęsti apsipirkimą
            </a>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<script>
  // Switch cart item to subscription
  function switchToSubscription(itemKey, planId) {
    fetch('/cart/change.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        id: itemKey,
        selling_plan: planId,
      }),
    })
      .then((response) => response.json())
      .then((data) => {
        // Reload the page to show updated cart
        window.location.reload();
      })
      .catch((error) => {
        console.error('Error switching to subscription:', error);
      });
  }

  // Switch cart item to one-time purchase
  function switchToOneTime(itemKey, quantity) {
    fetch('/cart/change.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        id: itemKey,
        quantity: quantity,
        selling_plan: null,
      }),
    })
      .then((response) => response.json())
      .then((data) => {
        // Reload the page to show updated cart
        window.location.reload();
      })
      .catch((error) => {
        console.error('Error switching to one-time:', error);
        // Fallback: just reload the page
        window.location.reload();
      });
  }
</script>

{% schema %}
{
  "name": "Cart Content",
  "tag": "section",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "review_title_prefix",
      "label": "Review title prefix",
      "default": "Review"
    },
    {
      "type": "text",
      "id": "review_title_strong",
      "label": "Review title strong",
      "default": "Cart"
    },
    {
      "type": "text",
      "id": "qty_less_alt",
      "label": "Quantity less icon alt",
      "default": "Less"
    },
    {
      "type": "text",
      "id": "qty_more_alt",
      "label": "Quantity more icon alt",
      "default": "More"
    },
    {
      "type": "text",
      "id": "remove_text",
      "label": "Remove link text",
      "default": "Remove"
    },
    {
      "type": "text",
      "id": "subtotal_label",
      "label": "Subtotal label",
      "default": "Subtotal:"
    },
    {
      "type": "text",
      "id": "tax_shipping_text",
      "label": "Tax and shipping note",
      "default": "Tax included. Shipping calculated at checkout."
    },
    {
      "type": "text",
      "id": "checkout_text",
      "label": "Checkout button text",
      "default": "Checkout"
    },
    {
      "type": "text",
      "id": "continue_shopping_text",
      "label": "Continue shopping text",
      "default": "Continue Shopping"
    },
    {
      "type": "text",
      "id": "empty_cart_text",
      "label": "Empty cart message",
      "default": "Your cart is empty."
    }
  ]
}
{% endschema %}
